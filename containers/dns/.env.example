TZ=Europe/Berlin

# Set this to the existing host path before deploying to an existing Pi-hole.
# PIHOLE_DATA_DIR=./etc-pihole

# Wird beim Install automatisch erzeugt, falls leer
PIHOLE_WEBPASSWORD=CHANGEME

# Reverse DNS über Fritzbox (optional)
PIHOLE_REV_SERVERS=true,192.168.178.0/24,192.168.178.1,fritz.box
